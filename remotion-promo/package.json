{
  "name": "potraces-promo",
  "version": "1.0.0",
  "description": "Apple-style motion-graphics promo for Potraces, built with Remotion.",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render CollectzPromo out/collectz-promo.mp4",
    "render:debt": "remotion render DebtPromo out/debt-promo.mp4",
    "render:potraces": "remotion render PotracesPromo out/potraces-promo.mp4",
    "vo": "node scripts/generate-vo.mjs",
    "sfx": "node scripts/generate-sfx.mjs",
    "echo-sfx": "node scripts/generate-echo-sfx.mjs",
    "echo-vo": "node scripts/generate-echo-vo.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "lucide-react": "^0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
