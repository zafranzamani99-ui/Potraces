{
  "buildCommand": null,
  "outputDirectory": "site",
  "framework": null,
  "headers": [
    {
      "source": "/ops.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "slug" }],
      "destination": "/order.html",
      "permanent": false
    },
    {
      "source": "/dl/quick-log",
      "destination": "https://jngmanwvhbpkpkeklfiv.supabase.co/storage/v1/object/public/web/PotracesQuickLog.shortcut?download=Potraces%20Quick%20Log.shortcut",
      "permanent": false
    },
    {
      "source": "/dl/auto-log",
      "destination": "https://jngmanwvhbpkpkeklfiv.supabase.co/storage/v1/object/public/web/PotracesAutoLog.shortcut?download=Potraces%20Auto%20Log.shortcut&v=20260724a",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/shortcut", "destination": "/get-shortcut.html" },
    { "source": "/autolog", "destination": "/get-autolog.html" },
    { "source": "/collectz/:path*", "destination": "/collectz.html" },
    { "source": "/r/:path*", "destination": "/r.html" }
  ]
}
